+    assert_eq!(layout.record_bytes(), RECORD_BYTES as u64);
+    assert_eq!(layout.plane_count(), LAYERS * 2);
+    assert_eq!(layout.plane(0).expect("plane 0"), planes[0]);
+    assert!(layout.plane(LAYERS * 2).is_err(), "out-of-range plane index");
+}
