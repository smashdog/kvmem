+        // The scorer read ONLY the two aligned query rows, never the ±1000 traps,
+        // and the accumulated mass picked block1 (ordinal 1 → block 200).
+        assert_eq!(*log0.borrow(), vec![1.0f32, 1.0], "chunk {chunk}: layer0 sliced operands");
