+        k_arenas: &[GpuTensor],
+        v_arenas: &[GpuTensor],
+        timed: bool,
+        t_spill: &mut std::time::Duration,
+        n_spilled: &mut usize,
+    ) -> Result<(), String> {
+        if spills.is_empty() {
+            return Ok(());
+        }
+        let stream = gpu.steady_copy_stream();
+        let batched = self.batch_xfer && !gpu.graphs.capture_mode;
+        if timed {
+            eprintln!(
+                "[kvmem-time] spill xfer={} pages={} stream={}",
+                if batched { "batch" } else { "page" },
+                spills.len(),
+                stream.is_some()
+            );
+        }
+        if !batched {
+            for &(lp, phys) in spills {
+                let t = std::time::Instant::now();
+                spill_page(
+                    gpu,
+                    &self.slots[s].raw,
+                    &mut self.page_k,
+                    &mut self.page_v,
+                    k_arenas,
+                    v_arenas,
+                    self.k_page_bytes,
+                    self.v_page_bytes,
+                    phys,
+                    lp,
+                )?;
+                pool.stage_out_page(SlotId(s), lp)
+                    .map_err(|e| format!("kvmem stage-out: {e}"))?;
+                if timed {
