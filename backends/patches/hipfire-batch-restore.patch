+                    let vsrc = &slab[off..off + vpb];
+                    self.slots[s]
+                        .raw
+                        .write_layer_v_gpu(pos0, KV_BLOCK_TOKENS as u32, il as u32, vsrc)
+                        .map_err(|e| format!("kvmem spill V store (layer {il}): {e}"))?;
+                    off += vpb;
+                    if il == 0 && verify_flag() {
+                        eprintln!(
+                            "[kvmem-verify] spill lp={lp} phys={phys} \
+                             k={:016x} v={:016x}",
+                            fnv64(ksrc),
+                            fnv64(vsrc)
