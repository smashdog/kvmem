+    if version != "2.0" {
+        return Err(format!("unsupported escha format_version {version:?}; expected \"2.0\""));
+    }
+    let arch: u32 = match method {
+        "eschamoe" => 6,
+        "escha" => 5,
+        other => return Err(format!("not an escha checkpoint: quant_method {other:?}")),
