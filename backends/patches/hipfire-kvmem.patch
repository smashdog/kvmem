+
+    echo "-- G2: tile decode vs escha_ref (expect 0 mismatched) --"
+    cargo run --release -p rdna-compute --example test_escha_decode_gpu_vs_cpu
+
+    echo "-- G3: H128 pair vs escha_ref (expect 0 mismatched) --"
