+        --escha-src) ESCHA_SRC="${2:?--escha-src requires a path}"; shift ;;
         --work-dir) WORK_DIR="${2:?--work-dir requires a path}"; shift ;;
         -h|--help) usage; exit 0 ;;
         *) echo "gates.sh: unknown argument: $1" >&2; usage >&2; exit 2 ;;
@@ -97,4 +120,40 @@ if [ "$RUN_PERF" -eq 1 ]; then
