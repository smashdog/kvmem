+        // Exactly 2.00 / 3.00 bits per weight — the format's own figures, so
+        // this also catches a tile-count or word-count slip.
+        assert_eq!(gu * 8, 2048 * 1024 * 2);
+        assert_eq!(dn * 8, 512 * 2048 * 3);
