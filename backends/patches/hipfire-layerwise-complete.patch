 /// (`kvmem::NativeKvLayerRegions`).
 pub struct KvRegions {
diff --git a/crates/hipfire-kvmem/tests/query_projection_tape_smoke.rs b/crates/hipfire-kvmem/tests/query_projection_tape_smoke.rs
