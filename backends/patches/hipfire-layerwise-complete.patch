+            1 => Ok(true),
+            0 => Ok(false),
+            _ => Err(err_from_last()),
+        }
+    }
+
+    pub fn options(&self) -> Result<PrefillOptions> {
+        let mut out: PrefillOptions = unsafe { std::mem::zeroed() };
+        let p = self.ptr.as_ptr();
