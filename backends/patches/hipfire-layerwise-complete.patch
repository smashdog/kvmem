+    }
+
+    /// Explicit model-native semantic scope (no Qwen markers installed; the
+    /// token-marker [`Self::begin`]/[`Self::prepare`] entry points reject this owner).
+    pub fn new_external(
+        session: SessionIdentity,
+        model_layers: &[u32],
