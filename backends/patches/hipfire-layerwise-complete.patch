+    }
+
+    /// Resident-only keep-set selection over `catalog`. `mandatory`/`sink_blocks`
+    /// must also be resident. Returns a NEW caller-owned choices handle.
+    pub fn select(
+        &self,
+        catalog: &MemoryCatalog,
+        mandatory: &[u64],
